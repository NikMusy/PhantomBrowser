<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ctp_mantle"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@color/ctp_surface2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tabs"
            android:textColor="@color/ctp_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetNewTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ghost_chip_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="+ Новая"
            android:textColor="@color/ctp_mauve"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabsRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:paddingVertical="6dp"
        android:clipToPadding="false" />
</LinearLayout>
