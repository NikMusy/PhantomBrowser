<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/ctp_crust"
                android:centerColor="@color/ctp_mantle"
                android:endColor="@color/ctp_base" />
